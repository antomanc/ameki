{
  "version": 1,
  "verify": "scripts/verify.sh",
  "protected": [
    ".github/workflows/ci.yml",
    "scripts/verify.sh",
    "scripts/check-conventions.py",
    "scripts/wellkept-check.mjs",
    "build-logic/src/main/kotlin/Conventions.kt"
  ],
  "rules": [
    {
      "id": "module-boundaries",
      "kind": "boundary",
      "message": "Features and widgets read weather through core/data, which owns the Sources; Room stays in core/data.",
      "source": "CODING_STANDARDS.md (Source seam, widget never touches Room)",
      "enforcedBy": "scripts/check-conventions.py rule 3",
      "check": "python3 scripts/check-conventions.py",
      "canary": {
        "path": "feature/settings/wellkept-canary.gradle.kts",
        "content": "dependencies {\n    implementation(project(\":source:google\"))\n}\n",
        "expect": "must not depend on source/google"
      },
      "added": "2026-11-16",
      "allow": {
        "path": "feature/settings/wellkept-allow.gradle.kts",
        "content": "dependencies {\n    implementation(projects.core.data)\n    implementation(project(\":core:ui\"))\n}\n"
      }
    },
    {
      "id": "app-boundaries",
      "kind": "boundary",
      "message": "The app module wires features, widgets and core; it reaches weather through core/data like everyone else.",
      "source": "wellkept re-run: app was skipped by the boundary check",
      "enforcedBy": "scripts/check-conventions.py rule 3",
      "check": "python3 scripts/check-conventions.py",
      "canary": {
        "path": "app/wellkept-canary.gradle.kts",
        "content": "dependencies {\n    implementation(project(\":source:google\"))\n}\n",
        "expect": "app must not depend on source/google"
      },
      "allow": {
        "path": "app/wellkept-allow.gradle.kts",
        "content": "dependencies {\n    implementation(projects.feature.home)\n    implementation(projects.widget)\n}\n"
      },
      "added": "2026-11-16"
    },
    {
      "id": "sources-stay-behind-core-data",
      "kind": "boundary",
      "message": "core/data uses concrete Sources with implementation(), so a feature that depends on core/data can't reach source/google or source/openmeteo through it.",
      "source": "wellkept re-run: core/data is the one module allowed source/*; api() would leak them",
      "enforcedBy": "scripts/check-conventions.py rule 3",
      "check": "python3 scripts/check-conventions.py",
      "canary": {
        "path": "core/data/wellkept-canary.gradle.kts",
        "content": "dependencies {\n    api(project(\":source:google\"))\n}\n",
        "expect": "core/data exposes source/google"
      },
      "allow": {
        "path": "core/data/wellkept-allow.gradle.kts",
        "content": "dependencies {\n    implementation(projects.source.openmeteo)\n    api(projects.source.api)\n}\n"
      },
      "added": "2026-11-16"
    },
    {
      "id": "room-in-core-data",
      "kind": "boundary",
      "message": "Room belongs to core/data; read stored data through its repositories.",
      "source": "CODING_STANDARDS.md (widget never touches Room)",
      "enforcedBy": "scripts/check-conventions.py rule 3 (any androidx.room reference, imported or fully qualified)",
      "check": "python3 scripts/check-conventions.py",
      "canary": {
        "path": "widget/src/main/kotlin/dev/antomanc/ameki/widget/WellkeptCanary.kt",
        "content": "package dev.antomanc.ameki.widget\nimport androidx.room.Room\n",
        "expect": "Room belongs to core/data"
      },
      "added": "2026-11-16",
      "allow": {
        "path": "widget/src/main/kotlin/dev/antomanc/ameki/widget/WellkeptAllow.kt",
        "content": "package dev.antomanc.ameki.widget\n\nimport dev.antomanc.ameki.core.data.widget.WidgetInstances\n\ninternal fun wellkeptAllow(instances: WidgetInstances, appWidgetId: Int) = instances.observe(appWidgetId)\n"
      }
    },
    {
      "id": "room-types-stay-in-core-data",
      "kind": "boundary",
      "message": "DAOs and entities stay inside core/data; read stored data through its repositories (WidgetInstances, PlaceRepository).",
      "source": "wellkept re-run: core/data may use Room, and its DAOs are public Koin singletons",
      "enforcedBy": "scripts/check-conventions.py rule 3",
      "check": "python3 scripts/check-conventions.py",
      "canary": {
        "path": "widget/src/main/kotlin/dev/antomanc/ameki/widget/WellkeptCanary.kt",
        "content": "package dev.antomanc.ameki.widget\n\nimport dev.antomanc.ameki.core.data.db.WidgetDao\n\ninternal fun wellkeptCanary(dao: WidgetDao) = dao\n",
        "expect": "DAOs and entities stay inside core/data"
      },
      "allow": {
        "path": "feature/locations/src/main/kotlin/dev/antomanc/ameki/feature/locations/WellkeptAllow.kt",
        "content": "package dev.antomanc.ameki.feature.locations\n\nimport dev.antomanc.ameki.core.data.PlaceRepository\n\ninternal fun wellkeptAllow(places: PlaceRepository) = places.places\n"
      },
      "added": "2026-11-16"
    },
    {
      "id": "no-direct-clock",
      "kind": "api",
      "message": "Take now as a parameter, from rememberWeatherTime() in the app or from Render in widgets, so it can be tested at any hour.",
      "source": "CODING_STANDARDS.md (Time), removed there",
      "enforcedBy": "scripts/check-conventions.py rule 4",
      "check": "python3 scripts/check-conventions.py",
      "canary": {
        "path": "feature/home/src/main/kotlin/dev/antomanc/ameki/feature/home/WellkeptCanary.kt",
        "content": "package dev.antomanc.ameki.feature.home\nfun wellkeptCanary() = java.time.Instant.now()\n",
        "expect": "reads the clock"
      },
      "added": "2026-11-16",
      "intent": "nuance-apis"
    },
    {
      "id": "compose-effects",
      "kind": "api",
      "message": "Decide in the ViewModel or a pure tested function (like nextStep) and let the composable apply the result; effects that coordinate state are where navigation bugs start.",
      "source": "wellkept audit: 11 of 15 effects in HomeScreen and DayPage",
      "enforcedBy": "wellkept-check probe",
      "check": "node scripts/wellkept-check.mjs",
      "probe": {
        "pattern": "\\b(LaunchedEffect|DisposableEffect|SideEffect)\\s*[({]",
        "include": [
          "**/src/main/**/*.kt"
        ],
        "exclude": [
          "feature/home/src/main/kotlin/dev/antomanc/ameki/feature/home/WeatherExtras.kt"
        ]
      },
      "canary": {
        "path": "feature/settings/src/main/kotlin/dev/antomanc/ameki/feature/settings/WellkeptCanary.kt",
        "content": "package dev.antomanc.ameki.feature.settings\nimport androidx.compose.runtime.*\n@Composable fun WellkeptCanary() { LaunchedEffect(Unit) {} }\n",
        "expect": "[compose-effects]"
      },
      "added": "2026-11-16",
      "baseline": {
        "app/src/main/kotlin/dev/antomanc/ameki/MainActivity.kt": 1,
        "core/ui/src/main/kotlin/dev/antomanc/ameki/core/ui/components/Instrument.kt": 1,
        "feature/home/src/main/kotlin/dev/antomanc/ameki/feature/home/DayPage.kt": 5,
        "feature/home/src/main/kotlin/dev/antomanc/ameki/feature/home/HomeScreen.kt": 6,
        "feature/settings/src/main/kotlin/dev/antomanc/ameki/feature/settings/SettingsScreen.kt": 1
      },
      "intent": "nuance-apis"
    },
    {
      "id": "kotlin-escape-hatches",
      "kind": "pattern",
      "message": "Make the value non-null where it is known (a local val, let, a non-null parameter) instead of !!, and fix the warning instead of suppressing it.",
      "source": "wellkept audit",
      "enforcedBy": "wellkept-check probe",
      "check": "node scripts/wellkept-check.mjs",
      "probe": {
        "pattern": "!!|@Suppress\\(",
        "include": [
          "**/src/main/**/*.kt"
        ]
      },
      "canary": {
        "path": "feature/settings/src/main/kotlin/dev/antomanc/ameki/feature/settings/WellkeptCanary.kt",
        "content": "package dev.antomanc.ameki.feature.settings\nfun wellkeptCanary(x: String?) = x!!\n",
        "expect": "[kotlin-escape-hatches]"
      },
      "added": "2026-11-16",
      "baseline": {
        "core/data/src/main/kotlin/dev/antomanc/ameki/core/data/WeatherRepository.kt": 1,
        "core/data/src/main/kotlin/dev/antomanc/ameki/core/data/location/DeviceLocation.kt": 1,
        "core/ui/src/main/kotlin/dev/antomanc/ameki/core/ui/ForecastView.kt": 1,
        "feature/home/src/main/kotlin/dev/antomanc/ameki/feature/home/Details.kt": 1,
        "feature/home/src/main/kotlin/dev/antomanc/ameki/feature/home/HomeScreen.kt": 1
      },
      "intent": "escape-hatches"
    }
  ],
  "declined": [
    {
      "id": "timers",
      "reason": "all four are legit: the rememberWeatherTime ticker, a search debounce, a scheduler delay, a settings interval",
      "date": "2026-11-16",
      "revisitWhen": "a timer appears outside the ticker, the search debounce and the scheduler"
    },
    {
      "id": "comment-ban",
      "reason": "comments here explain domain decisions (6% of lines); the clock and boundary rules replace the ones that defended shortcuts",
      "date": "2026-11-16",
      "revisitWhen": "comments start defending shortcuts (the justification-comments probe goes above 0)"
    },
    {
      "id": "detekt",
      "reason": "the existing convention script plus wellkept-check carry the current rules; revisit at three or more rules that need a parser",
      "date": "2026-11-16",
      "revisitWhen": "three or more rules need a parser, or a regex rule misfires"
    }
  ],
